# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (prefer DATABASE_URL in production)
DATABASE_URL=postgres://postgres:password@localhost:5432/bimuz_db

# CORS (production: set origins, keep CORS_ALLOW_ALL_ORIGINS=False)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# AWS S3 — lesson videos, thumbnails, homework files
# Required in production (DJANGO_ENV=production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
# Optional: CloudFront domain, e.g. d1234abcd.cloudfront.net
# AWS_S3_CUSTOM_DOMAIN=
# Set True for private bucket (signed URLs); False needs public read bucket policy
AWS_S3_QUERYSTRING_AUTH=False

# Production only
# SECURE_SSL_REDIRECT=True

# Frontend URL
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/
